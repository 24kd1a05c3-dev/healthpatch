HEALTHPATCH_DOMAIN=health.example.com
ENVIRONMENT=production
MONGODB_URI=mongodb+srv://replace-user:replace-password@replace-cluster/healthpatch?retryWrites=true&w=majority
DATABASE_NAME=healthpatch
JWT_SECRET_KEY=replace-with-a-private-random-secret
CORS_ORIGINS=["https://health.example.com"]
ALLOWED_HOSTS=["health.example.com","api"]
RATE_LIMIT_BACKEND=mongo
PASSWORD_RESET_URL_BASE=https://health.example.com/reset-password
SMTP_HOST=replace-smtp-host
SMTP_PORT=587
SMTP_USERNAME=replace-smtp-user
SMTP_PASSWORD=replace-smtp-password
SMTP_FROM_EMAIL=noreply@health.example.com
SMTP_USE_TLS=true
# Trust only the reverse-proxy network; set its actual subnet in your deployment.
FORWARDED_ALLOW_IPS=172.30.91.2
NOTIFICATIONS_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_VERIFY_SERVICE_SID=
NOTIFICATION_PUBLIC_BASE=https://health.example.com/api
