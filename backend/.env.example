ENVIRONMENT=development
MONGODB_URI=mongodb://localhost:27017
DATABASE_NAME=healthpatch
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=10
PASSWORD_RESET_EXPIRE_MINUTES=30
PASSWORD_RESET_URL_BASE=http://localhost:5173/reset-password
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_AUTH_MAX_ATTEMPTS=10
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Required when ENVIRONMENT=production
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=replace-me
# SMTP_PASSWORD=replace-me
# SMTP_FROM_EMAIL=no-reply@example.com
# SMTP_USE_TLS=true

# Directory containing licensed dataset files (for BIDMC use its bidmc_csv folder)
DATASET_ROOT=datasets
TELEMETRY_PROCESSING_VERSION=1.0.0
